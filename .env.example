# AI-SyncForge 环境变量配置文件示例
# 复制此文件为 .env 并根据需要修改

# MCP 桥接服务端口 (默认 8000)
SYNCFORGE_PORT=8000

# 运维吹哨人死锁判定时间 (默认 600秒/10分钟)
# 任务在 testing 状态停滞超过此时间将被判定为死锁，由 Ops 介入
WHISTLEBLOWER_TIMEOUT=600

# 开发者物理断开兜底时间 (默认 1200秒/20分钟)
# 仅作为协程泄露防护，建议设为 WHISTLEBLOWER_TIMEOUT 的 2 倍
PHYSICAL_TIMEOUT=1200

# 数据库存储路径 (默认为当前目录下的 task_queue.db)
DB_PATH=./task_queue.db

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
